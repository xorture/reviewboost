# ============================================================
# ReviewBoost - Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# App
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
FEEDBACK_BASE_URL=http://localhost:3000/f

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=reviewboost
DB_PASSWORD=reviewboost_secret
DB_NAME=reviewboost
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (AES-256 for GDPR - phone numbers)
# Must be exactly 32 characters
ENCRYPTION_KEY=your_32_char_encryption_key_here_

# WhatsApp - Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp - Meta Business API (alternative)
META_WHATSAPP_TOKEN=your_meta_whatsapp_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_VERIFY_TOKEN=your_webhook_verify_token

# Active WhatsApp provider: 'twilio' | 'meta'
WHATSAPP_PROVIDER=twilio

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_ID_BASIC=price_basic_monthly
STRIPE_PRICE_ID_PRO=price_pro_monthly
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_monthly

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@reviewboost.ro

# Mero API
MERO_API_BASE_URL=https://api.mero.ro/v1
MERO_WEBHOOK_SECRET=your_mero_webhook_secret

# Sentry (Error tracking)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=30
